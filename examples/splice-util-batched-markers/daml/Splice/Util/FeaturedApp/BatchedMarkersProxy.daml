module Splice.Util.FeaturedApp.BatchedMarkersProxy where

import qualified Splice.Api.FeaturedAppRightV1 as FeaturedAppRightV1

import qualified Splice.Api.FeaturedAppRightV2 as FeaturedAppRightV2

import DA.Action (foldlA)

data BatchedMarkersProxy_CreateMarkersResult = BatchedMarkersProxy_CreateMarkersResult
  with
    results : [[FeaturedAppRightV1.FeaturedAppRight_CreateActivityMarkerResult]]

data BatchedMarkersProxy_CreateMarkersV2Result = BatchedMarkersProxy_CreateMarkersV2Result
  with
    results : [FeaturedAppRightV2.FeaturedAppRight_CreateActivityMarkerResult]

data RewardBatch = RewardBatch
  with
    beneficiaries : [FeaturedAppRightV1.AppRewardBeneficiary]
    num_markers : Int
  deriving (Eq, Show)

data RewardBatchV2 = RewardBatchV2
  with
    beneficiaries : [FeaturedAppRightV2.AppRewardBeneficiary]
    marker_weight : Decimal
  deriving (Eq, Show)

data PartyWithWeight = PartyWithWeight
  with
    party : Party
    weight : Decimal
  deriving (Eq, Show)

collect_marker_beneficiaries : [RewardBatch] -> [Party]
collect_marker_beneficiaries batches =
  let (beneficiaries : [Party]) = [] in
  let _damlforge_beneficiaries3 =
        foldl
          (\beneficiaries batch ->
            let _damlforge_beneficiaries2 =
                  foldl
                    (\beneficiaries entry ->
                      let _damlforge_beneficiaries1 = beneficiaries <> [entry.beneficiary] in
                      _damlforge_beneficiaries1)
                    beneficiaries batch.beneficiaries
            in
            _damlforge_beneficiaries2)
          beneficiaries batches
  in
  _damlforge_beneficiaries3

collect_marker_beneficiaries_v2 : [RewardBatchV2] -> [Party]
collect_marker_beneficiaries_v2 batches =
  let (beneficiaries : [Party]) = [] in
  let _damlforge_beneficiaries6 =
        foldl
          (\beneficiaries batch ->
            let _damlforge_beneficiaries5 =
                  foldl
                    (\beneficiaries entry ->
                      let _damlforge_beneficiaries4 = beneficiaries <> [entry.beneficiary] in
                      _damlforge_beneficiaries4)
                    beneficiaries batch.beneficiaries
            in
            _damlforge_beneficiaries5)
          beneficiaries batches
  in
  _damlforge_beneficiaries6

sum_weights : [PartyWithWeight] -> Decimal
sum_weights parties =
  let total_weight = (0.0 : Decimal) in
  let _damlforge_total_weight8 =
        foldl
          (\total_weight entry ->
            let _damlforge_total_weight7 = total_weight + entry.weight in
            _damlforge_total_weight7)
          total_weight parties
  in
  _damlforge_total_weight8

template BatchedMarkersProxy
  with
    provider : Party
    dso : Party
  where
    signatory provider

    nonconsuming choice BatchedMarkersProxy_CreateMarkers : BatchedMarkersProxy_CreateMarkersResult
      with
        featured_app_right_cid : ContractId FeaturedAppRightV1.FeaturedAppRight
        batches : [RewardBatch]
      observer [dso] ++ collect_marker_beneficiaries batches
      controller provider
      do
        let self = this
        assertMsg "numMarkers > 0" (all (\batch -> batch.num_markers > 0) batches)
        let total_markers = 0
        let _damlforge_total_markers10 =
              foldl
                (\total_markers batch ->
                  let _damlforge_total_markers9 = total_markers + batch.num_markers in
                  _damlforge_total_markers9)
                total_markers batches
        assertMsg "sum numMarkers <= 10000" (_damlforge_total_markers10 <= 10000)
        featured_app_right <- fetch featured_app_right_cid
        let (featured_app_right_view : FeaturedAppRightV1.FeaturedAppRightView) = view featured_app_right
        assertMsg "DSO party on featured app right is correct" (featured_app_right_view.dso == self.dso)
        let (results : [[FeaturedAppRightV1.FeaturedAppRight_CreateActivityMarkerResult]]) = []
        _damlforge_results14 <-
          foldlA
            (\results batch -> do
              let (batch_results : [FeaturedAppRightV1.FeaturedAppRight_CreateActivityMarkerResult]) = []
              _damlforge_batch_results12 <-
                foldlA
                  (\batch_results _index -> do
                    marker_result <- exercise featured_app_right_cid (FeaturedAppRightV1.FeaturedAppRight_CreateActivityMarker with beneficiaries = batch.beneficiaries)
                    let _damlforge_batch_results11 = batch_results <> [marker_result]
                    pure _damlforge_batch_results11)
                  batch_results [0 .. (batch.num_markers) - 1]
              let _damlforge_results13 = results <> [_damlforge_batch_results12]
              pure _damlforge_results13)
            results batches
        pure (BatchedMarkersProxy_CreateMarkersResult with results = _damlforge_results14)

    nonconsuming choice BatchedMarkersProxy_TestEqual : Bool
      with
        val1 : Bool
        val2 : Bool
        parties : [PartyWithWeight]
      observer [dso]
      controller provider
      do
        let self = this
        assertMsg "weight >= 10.0" (all (\entry -> entry.weight >= (10.0 : Decimal)) parties)
        pure (val1 == val2)

    nonconsuming choice BatchedMarkersProxy_CreateMarkersV2 : BatchedMarkersProxy_CreateMarkersV2Result
      with
        featured_app_right_cid : ContractId FeaturedAppRightV2.FeaturedAppRight
        batches : [RewardBatchV2]
      observer [dso] ++ collect_marker_beneficiaries_v2 batches
      controller provider
      do
        let self = this
        assertMsg "markerWeight >= 1.0" (all (\batch -> batch.marker_weight >= (1.0 : Decimal)) batches)
        let total_weight = (0.0 : Decimal)
        let _damlforge_total_weight16 =
              foldl
                (\total_weight batch ->
                  let _damlforge_total_weight15 = total_weight + batch.marker_weight in
                  _damlforge_total_weight15)
                total_weight batches
        assertMsg "sum numMarkers <= 10000.0" (_damlforge_total_weight16 <= (10000.0 : Decimal))
        featured_app_right <- fetch featured_app_right_cid
        let (featured_app_right_view : FeaturedAppRightV2.FeaturedAppRightView) = view featured_app_right
        assertMsg "DSO party on featured app right is correct" (featured_app_right_view.dso == self.dso)
        let (results : [FeaturedAppRightV2.FeaturedAppRight_CreateActivityMarkerResult]) = []
        _damlforge_results18 <-
          foldlA
            (\results batch -> do
              marker_result <- exercise featured_app_right_cid (FeaturedAppRightV2.FeaturedAppRight_CreateActivityMarker with beneficiaries = batch.beneficiaries, weight = Some batch.marker_weight)
              let _damlforge_results17 = results <> [marker_result]
              pure _damlforge_results17)
            results batches
        pure (BatchedMarkersProxy_CreateMarkersV2Result with results = _damlforge_results18)

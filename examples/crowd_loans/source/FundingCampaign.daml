module FundingCampaign where

import DA.Time
import DA.Action (when)
import DA.List (dedupSort, head, tail)
import DA.Optional
import qualified Splice.Amulet as Amulet
import Splice.Amulet (LockedAmulet, LockedAmulet_UnlockV2(..))
import Splice.AmuletRules (AppTransferContext(..), Transfer(..), TransferInput(..), TransferOutput(..), CreatedAmulet(..), exerciseAppTransfer, createdAmuletToHolding)
import Splice.Expiry (TimeLock(..))
import qualified Splice.Api.Token.HoldingV1 as Holding
import qualified LoanTerms as LT

data CampaignStatus = Active | Successful | Failed | Completed | Cancelled | Paused
  deriving (Eq, Show)

data FundingCampaignView = FundingCampaignView
  with
    platform : Party
    developer : Party
    dso : Party
    externalId : Text
    target : Decimal
    deadline : Time
    raised : Decimal
    status : CampaignStatus
    acceptedInstrumentId : Holding.InstrumentId
    totalInvestors : Int
    investments : [(Party, Decimal)]
    excessInvestments : [(Party, Decimal)]
  deriving (Eq, Show)

data InstallmentReleaseView = InstallmentReleaseView
  with
    platform : Party
    developer : Party
    externalId : Text
    installmentNumber : Int
    amount : Decimal
    releaseDate : Time
    released : Bool
    escrowed : Bool
    paused : Bool
  deriving (Eq, Show)

data TransferStatus = Pending | Accepted | Rejected | Withdrawn
  deriving (Eq, Show)

data InstallmentTransferView = InstallmentTransferView
  with
    platform : Party
    developer : Party
    dso : Party
    externalId : Text
    installmentNumber : Int
    amount : Decimal
    status : TransferStatus
    acceptBefore : Time
  deriving (Eq, Show)

data FundMode = AllOrNothing | Flexible
    deriving (Eq, Show)

data Terms = Terms
  with
    platform_fees : Decimal
    fund_mode: FundMode
    cooldown_period_days : Int
    flexible_funding_minimum : Decimal
    cap_at_target : Bool
    locked_party: Optional Party
    unlocked_party: Optional Party
  deriving (Eq, Show)

template FundingCampaign
  with
    platform: Party
    developer: Party
    dso: Party
    externalId: Text
    target: Decimal
    deadline: Time
    raised: Decimal
    balance: Decimal
    status: CampaignStatus
    acceptedInstrumentId: Holding.InstrumentId
    terms: Terms
    investments: Optional [(Party, Decimal)]
    excessInvestments: Optional [(Party, Decimal)]
    excessHoldings: Optional [(Party, ContractId LockedAmulet)]
    lockedHoldings: Optional [(Party, ContractId LockedAmulet)]
    unlockedHoldings: Optional [(Party, ContractId Holding.Holding)]
    refundedInvestors: Optional [Party]
    loanTerms: Optional LT.LoanTerms
    finalizedAt: Optional Time
  where
    signatory platform, developer
    observer dedupSort (map fst (fromOptional [] investments) <> map fst (fromOptional [] excessInvestments))

    ensure
      target > 0.0 &&
      raised >= 0.0 &&
      balance <= raised &&
      terms.platform_fees >= 0.0 &&
      terms.platform_fees <= 1.0 &&
      terms.flexible_funding_minimum >= 0.0 &&
      terms.flexible_funding_minimum <= target &&
      terms.cooldown_period_days >= 0

    choice FundingCampaign_Invest : ContractId FundingCampaign
      with
        investor : Party
        inputs : [ContractId Amulet.Amulet]
        amount : Decimal
        appTransferContext : AppTransferContext
      controller investor, platform
      do
        assertMsg "campaign must be Active" (status == Active)
        assertMsg "investment amount must be positive" (amount > 0.0)

        inputAmount <- verifyAmulets dso inputs
        assertMsg "insufficient funds for investment" (inputAmount >= amount)

        let remaining = if terms.cap_at_target then max 0.0 (target - raised) else amount
        let acceptedAmount = min amount remaining
        let excessAmount = amount - acceptedAmount

        let mkLock ctx amt = TransferOutput with
              receiver = platform
              receiverFeeRatio = 0.0
              amount = amt
              lock = Some $ TimeLock with
                holders = [platform]
                expiresAt = deadline
                optContext = Some ctx

        let acceptedOutputs = [mkLock ("Investment for campaign " <> externalId) acceptedAmount | acceptedAmount > 0.0]
        let excessOutputs = [mkLock ("Excess for campaign " <> externalId) excessAmount | excessAmount > 0.0]

        let transfer = Transfer with
              sender = platform
              provider = platform
              inputs = map InputAmulet inputs
              outputs = acceptedOutputs <> excessOutputs
              beneficiaries = None

        transferResult <- exerciseAppTransfer dso appTransferContext transfer
        let lockedCids = [cid | TransferResultLockedAmulet cid <- transferResult.createdAmulets]
        let (acceptedCids, excessCids) =
              if acceptedAmount > 0.0 && excessAmount > 0.0
                then (take 1 lockedCids, drop 1 lockedCids)
                else if acceptedAmount > 0.0
                  then (lockedCids, [])
                  else ([], lockedCids)

        let currentInvestments = fromOptional [] investments
        let currentLockedHoldings = fromOptional [] lockedHoldings
        let currentExcessInvestments = fromOptional [] excessInvestments
        let currentExcessHoldings = fromOptional [] excessHoldings

        let newInvestments =
              if acceptedAmount > 0.0
                then updateInvestments investor acceptedAmount currentInvestments
                else currentInvestments
        let newExcessInvestments =
              if excessAmount > 0.0
                then updateInvestments investor excessAmount currentExcessInvestments
                else currentExcessInvestments

        create this with
          raised = raised + acceptedAmount
          balance = balance + acceptedAmount
          investments = Some newInvestments
          lockedHoldings = Some (map (\cid -> (investor, cid)) acceptedCids <> currentLockedHoldings)
          excessInvestments = Some newExcessInvestments
          excessHoldings = Some (map (\cid -> (investor, cid)) excessCids <> currentExcessHoldings)

    choice FundingCampaign_Finalize : ContractId FundingCampaign
      with
        currentTime : Time
      controller platform
      do
        assertMsg "Must be Active" (status == Active)

        let newStatus = case terms.fund_mode of
              AllOrNothing -> if raised >= target then Successful else Failed
              Flexible -> if raised >= terms.flexible_funding_minimum then Successful else Failed

        create this with
          status = newStatus
          finalizedAt = Some currentTime

    choice FundingCampaign_Cancel : ContractId FundingCampaign
      controller platform
      do
        assertMsg "Can only cancel Successful or Completed campaigns" (status == Successful || status == Completed)
        let currentLockedHoldings = fromOptional [] lockedHoldings
        let currentUnlockedHoldings = fromOptional [] unlockedHoldings
        assertMsg "Must have remaining holdings to refund" (not (null currentLockedHoldings && null currentUnlockedHoldings))
        create this with status = Cancelled

    choice FundingCampaign_CreateInstallments : ([ContractId InstallmentRelease], ContractId FundingCampaign)
      with
        appTransferContext : AppTransferContext
      controller platform, developer
      do
        assertMsg "must be successful" (status == Successful)
        assertMsg "must have funds to distribute" (raised > 0.0)

        let currentLockedHoldings = fromOptional [] lockedHoldings
        let currentInvestments = fromOptional [] investments

        newUnlockedHoldings <- forA currentLockedHoldings $ \(inv, lockedCid) -> do
          unlockResult <- exercise lockedCid LockedAmulet_UnlockV2
          let holdingCid = toInterfaceContractId @Holding.Holding unlockResult.amuletCid
          return (inv, holdingCid)

        trackerCidOpt <- case loanTerms of
          None -> return None
          Some lt -> do
            trackerCid <- create LT.LoanTracker with
              platform
              developer
              dso
              campaignExternalId = externalId
              loanTerms = lt
              totalRepaid = 0.0
              repaymentHistory = []
              investments = currentInvestments
              totalRaised = raised
              balance = 0.0
              holdingCids = []
            return (Some trackerCid)

        let installmentAmounts = calculateInstallments raised
        let holdingsPerInstallment = splitHoldingsIntoTranches (map snd newUnlockedHoldings) 3
        let firstInstallmentHoldings = head holdingsPerInstallment
        let remainingHoldingsForInstallments = tail holdingsPerInstallment

        let anchorTime = fromOptional deadline finalizedAt
        let createInstallment (month, amt, installmentHoldings, shouldEscrow) = do
              create InstallmentRelease with
                platform = platform
                developer = developer
                dso = dso
                externalId = externalId
                installmentNumber = month
                amount = amt
                releaseDate = addRelTime anchorTime (days (terms.cooldown_period_days + 30 * month))
                released = False
                escrowed = shouldEscrow
                platformFees = terms.platform_fees
                holdingCids = if shouldEscrow then installmentHoldings else []
                paused = False
                loanTrackerCid = trackerCidOpt

        let installment1Data = (1, head installmentAmounts, firstInstallmentHoldings, True)
        let otherInstallmentsData = [(month, amt, [], False) | (month, amt) <- zip [2..3] (tail installmentAmounts)]

        installments <- mapA createInstallment (installment1Data :: otherInstallmentsData)

        let nonEscrowedHoldingCids = concat remainingHoldingsForInstallments
        let firstInstallmentAmount = head installmentAmounts
        let remainingUnlockedHoldingsList = [(inv, h) | (inv, h) <- newUnlockedHoldings, h `elem` nonEscrowedHoldingCids]

        updatedCampaign <- create this with
          status = Completed
          balance = balance - firstInstallmentAmount
          lockedHoldings = Some []
          unlockedHoldings = Some remainingUnlockedHoldingsList

        return (installments, updatedCampaign)

    choice FundingCampaign_ClaimRefund : (ContractId FundingCampaign, [ContractId Holding.Holding])
      with
        investor : Party
        receiver : Party
        appTransferContext : AppTransferContext
      controller investor, platform
      do
        assertMsg "Campaign must be Failed or Cancelled" (status == Failed || status == Cancelled)

        let currentRefundedInvestors = fromOptional [] refundedInvestors
        let currentLockedHoldings = fromOptional [] lockedHoldings
        let currentInvestments = fromOptional [] investments

        assertMsg "Investor has already been refunded" (investor `notElem` currentRefundedInvestors)
        assertMsg "Must have holdings to refund" (not $ null currentLockedHoldings)

        let investorAmount = case lookup investor currentInvestments of
              Some amt -> amt
              None -> 0.0
        assertMsg "Investor has no recorded investment" (investorAmount > 0.0)

        let totalInvestments = sum (map snd currentInvestments)
        let proportion = investorAmount / totalInvestments
        let totalHoldings = length currentLockedHoldings
        let numHoldingsForInvestor =
              if totalHoldings == 0 then 0
              else max 1 (floor (proportion * intToDecimal totalHoldings))
        let cappedNum = min numHoldingsForInvestor totalHoldings

        let allLockedCids = map snd currentLockedHoldings
        let (refundLockedCids, remainingLockedCids) = splitAt cappedNum allLockedCids

        unlockResults <- forA refundLockedCids $ \lockedCid -> do
          unlockResult <- exercise lockedCid LockedAmulet_UnlockV2
          amulet <- fetch unlockResult.amuletCid
          return (unlockResult.amuletCid, amulet.amount.initialAmount)

        let unlockedAmuletCids = map fst unlockResults
        let refundedAmount = sum (map snd unlockResults)

        let refundOutput = TransferOutput with
              receiver = receiver
              receiverFeeRatio = 1.0
              amount = refundedAmount
              lock = None

        let transfer = Transfer with
              sender = platform
              provider = platform
              inputs = map InputAmulet unlockedAmuletCids
              outputs = [refundOutput]
              beneficiaries = None

        transferResult <- exerciseAppTransfer dso appTransferContext transfer
        let refundedHoldings = map createdAmuletToHolding transferResult.createdAmulets

        let newLockedHoldings = filter (\(_, h) -> h `elem` remainingLockedCids) currentLockedHoldings

        newCampaign <- create this with
          refundedInvestors = Some (investor :: currentRefundedInvestors)
          balance = balance - refundedAmount
          lockedHoldings = Some newLockedHoldings

        return (newCampaign, refundedHoldings)

    choice FundingCampaign_ClaimExcess : (ContractId FundingCampaign, [ContractId Holding.Holding])
      with
        investor : Party
        receiver : Party
        appTransferContext : AppTransferContext
      controller investor, platform
      do
        let currentExcessInvestments = fromOptional [] excessInvestments
        let currentExcessHoldings = fromOptional [] excessHoldings

        let investorExcess = fromOptional 0.0 (lookup investor currentExcessInvestments)
        assertMsg "Investor has no excess to claim" (investorExcess > 0.0)

        let investorLockedCids = [cid | (p, cid) <- currentExcessHoldings, p == investor]
        assertMsg "Investor has no excess holdings" (not $ null investorLockedCids)

        unlockResults <- forA investorLockedCids $ \lockedCid -> do
          unlockResult <- exercise lockedCid LockedAmulet_UnlockV2
          amulet <- fetch unlockResult.amuletCid
          return (unlockResult.amuletCid, amulet.amount.initialAmount)

        let unlockedAmuletCids = map fst unlockResults
        let returnedAmount = sum (map snd unlockResults)

        let returnOutput = TransferOutput with
              receiver = receiver
              receiverFeeRatio = 1.0
              amount = returnedAmount
              lock = None

        let transfer = Transfer with
              sender = platform
              provider = platform
              inputs = map InputAmulet unlockedAmuletCids
              outputs = [returnOutput]
              beneficiaries = None

        transferResult <- exerciseAppTransfer dso appTransferContext transfer
        let returnedHoldings = map createdAmuletToHolding transferResult.createdAmulets

        let newExcessHoldings = filter (\(p, _) -> p /= investor) currentExcessHoldings
        let newExcessInvestments = filter (\(p, _) -> p /= investor) currentExcessInvestments

        newCampaign <- create this with
          excessHoldings = Some newExcessHoldings
          excessInvestments = Some newExcessInvestments

        return (newCampaign, returnedHoldings)

    choice FundingCampaign_Pause : (ContractId FundingCampaign, [ContractId InstallmentRelease])
      with
        installmentCids : [ContractId InstallmentRelease]
      controller platform
      do
        assertMsg "Can only pause Successful campaigns" (status == Successful)

        pausedInstallments <- forA installmentCids $ \installmentCid -> do
          installmentData <- fetch installmentCid
          if installmentData.released || installmentData.paused
            then return installmentCid
            else do
              archive installmentCid
              create installmentData with paused = True

        newCampaign <- create this with status = Paused
        return (newCampaign, pausedInstallments)

    choice FundingCampaign_Resume : (ContractId FundingCampaign, [ContractId InstallmentRelease])
      with
        installmentCids : [ContractId InstallmentRelease]
      controller platform
      do
        assertMsg "Campaign not paused" (status == Paused)

        resumedInstallments <- forA installmentCids $ \installmentCid -> do
          installmentData <- fetch installmentCid
          if not installmentData.paused
            then return installmentCid
            else do
              archive installmentCid
              create installmentData with paused = False

        newCampaign <- create this with status = Successful
        return (newCampaign, resumedInstallments)

    nonconsuming choice FundingCampaign_GetInvestments : [(Party, Decimal)]
      controller platform
      do
        return (fromOptional [] investments)

template InstallmentRelease
  with
    platform: Party
    developer: Party
    dso: Party
    externalId: Text
    installmentNumber: Int
    amount: Decimal
    releaseDate: Time
    released: Bool
    escrowed: Bool
    platformFees: Decimal
    holdingCids: [ContractId Holding.Holding]
    paused: Bool
    loanTrackerCid: Optional (ContractId LT.LoanTracker)
  where
    signatory platform, developer

    ensure
      amount > 0.0 &&
      installmentNumber > 0 &&
      platformFees >= 0.0 &&
      platformFees <= 1.0 &&
      (escrowed == (not $ null holdingCids))

    choice InstallmentRelease_Escrow : (ContractId InstallmentRelease, ContractId FundingCampaign)
      with
        campaignCid : ContractId FundingCampaign
      controller platform
      do
        assertMsg "Installment is paused" (not paused)
        assertMsg "Installment already escrowed" (not escrowed)
        assertMsg "Cannot escrow released installment" (not released)

        campaignData <- fetch campaignCid

        assertMsg "Campaign must be Completed" (campaignData.status == Completed)
        assertMsg "Campaign has insufficient balance" (campaignData.balance >= amount)

        let currentUnlockedHoldings = fromOptional [] campaignData.unlockedHoldings
        let numHoldingsNeeded = calculateNumHoldingsNeeded currentUnlockedHoldings amount
        let (escrowedHoldings, remainingHoldings) = splitAt numHoldingsNeeded currentUnlockedHoldings

        archive campaignCid
        updatedCampaign <- create campaignData with
          balance = campaignData.balance - amount
          unlockedHoldings = Some remainingHoldings

        updatedInstallment <- create this with
          escrowed = True
          holdingCids = map snd escrowedHoldings

        return (updatedInstallment, updatedCampaign)

    choice InstallmentRelease_Release : (ContractId InstallmentRelease, ContractId InstallmentTransfer, [ContractId Holding.Holding])
      with
        currentTime : Time
        acceptBefore : Time
      controller platform
      do
        assertMsg ("Installment " <> show installmentNumber <> " is currently paused and cannot be released") (not paused)
        assertMsg ("Release date " <> show releaseDate <> " not reached, current time is " <> show currentTime) (currentTime >= releaseDate)
        assertMsg ("Installment " <> show installmentNumber <> " has already been released") (not released)
        assertMsg ("Installment " <> show installmentNumber <> " must be escrowed before release") escrowed
        assertMsg ("Installment " <> show installmentNumber <> " has no holdings to release") (not $ null holdingCids)
        assertMsg ("Accept deadline " <> show acceptBefore <> " must be after current time " <> show currentTime) (acceptBefore > currentTime)

        case loanTrackerCid of
          None -> pure ()
          Some trackerCid -> do
            when (installmentNumber > 1) $ do
              trackerData <- fetch trackerCid
              assertMsg ("Loan tracker state appears inconsistent for installment " <> show installmentNumber)
                (isSome trackerData.loanTerms.loanRewards || installmentNumber == 1)

              case trackerData.loanTerms.loanRewards of
                None -> pure ()
                Some rewards -> do
                  let requiredPeriod = installmentNumber - 1
                  let paidPeriods = filter (\p -> p.status == LT.PeriodPaid) rewards.periodPayments
                  let paidPeriodNumbers = map (\p -> p.periodNumber) paidPeriods
                  assertMsg ("Period " <> show requiredPeriod <> " must be paid before releasing installment " <> show installmentNumber <>
                            ". Paid periods: " <> show paidPeriodNumbers)
                    (requiredPeriod `elem` paidPeriodNumbers)

        let numHoldings = length holdingCids
        assertMsg ("Installment " <> show installmentNumber <> " must have at least one holding") (numHoldings > 0)

        let numForPlatform = floor (intToDecimal numHoldings * platformFees)
        let (platformHoldingCids, developerHoldingCids) = splitAt numForPlatform holdingCids

        assertMsg ("Developer must receive at least one holding for installment " <> show installmentNumber)
          (not $ null developerHoldingCids)

        transferCid <- create InstallmentTransfer with
          platform = platform
          developer = developer
          dso = dso
          externalId = externalId
          installmentNumber = installmentNumber
          amount = amount
          status = Pending
          acceptBefore = acceptBefore
          holdingCids = developerHoldingCids

        updatedInstallment <- create this with
          released = True
          escrowed = False
          holdingCids = []

        return (updatedInstallment, transferCid, platformHoldingCids)

    choice InstallmentRelease_Pause : ContractId InstallmentRelease
      controller platform
      do
        assertMsg "Installment already paused" (not paused)
        assertMsg "Cannot pause released installment" (not released)
        create this with paused = True

    choice InstallmentRelease_Resume : ContractId InstallmentRelease
      controller platform
      do
        assertMsg "Installment not paused" paused
        create this with paused = False

template InstallmentTransfer
  with
    platform: Party
    developer: Party
    dso: Party
    externalId: Text
    installmentNumber: Int
    amount: Decimal
    status: TransferStatus
    acceptBefore: Time
    holdingCids: [ContractId Holding.Holding]
  where
    signatory platform, developer

    ensure
      amount > 0.0 &&
      installmentNumber > 0 &&
      not (null holdingCids)

    choice InstallmentTransfer_Accept : [ContractId Holding.Holding]
      with
        currentTime : Time
        appTransferContext : AppTransferContext
      controller developer, platform
      do
        assertMsg "Transfer must be Pending" (status == Pending)
        assertMsg "Accept deadline has passed" (currentTime < acceptBefore)

        totalAmount <- do
          amounts <- forA holdingCids $ \holdingCid -> do
            let amuletCid = fromInterfaceContractId @Amulet.Amulet holdingCid
            amulet <- fetch amuletCid
            return amulet.amount.initialAmount
          return (sum amounts)

        let developerOutput = TransferOutput with
              receiver = developer
              receiverFeeRatio = 1.0
              amount = totalAmount
              lock = None

        let transfer = Transfer with
              sender = platform
              provider = platform
              inputs = map (InputAmulet . fromInterfaceContractId) holdingCids
              outputs = [developerOutput]
              beneficiaries = None

        transferResult <- exerciseAppTransfer dso appTransferContext transfer
        return (map createdAmuletToHolding transferResult.createdAmulets)

    choice InstallmentTransfer_Reject : ()
      controller developer
      do
        assertMsg "Transfer must be Pending" (status == Pending)
        return ()

    choice InstallmentTransfer_Withdraw : ()
      with
        currentTime : Time
      controller platform
      do
        assertMsg "Transfer must be Pending" (status == Pending)
        assertMsg "Cannot withdraw before deadline" (currentTime >= acceptBefore)
        return ()

calculateInstallments : Decimal -> [Decimal]
calculateInstallments total =
  let third = total / 3.0
      remainder = total - (third * 2.0)
  in [third, third, remainder]

updateInvestments : Party -> Decimal -> [(Party, Decimal)] -> [(Party, Decimal)]
updateInvestments investor amount existing =
  case lookup investor existing of
    Some oldAmount -> (investor, oldAmount + amount) :: filter (\(p, _) -> p /= investor) existing
    None -> (investor, amount) :: existing

splitAtSizes : [ContractId Holding.Holding] -> [Int] -> [[ContractId Holding.Holding]]
splitAtSizes [] _ = []
splitAtSizes xs [] = [xs]
splitAtSizes xs (s::ss) =
  let (chunk, rest) = splitAt s xs
  in chunk :: splitAtSizes rest ss

splitHoldingsIntoTranches : [ContractId Holding.Holding] -> Int -> [[ContractId Holding.Holding]]
splitHoldingsIntoTranches holdings numTranches =
  let len = length holdings
      baseSize = len / numTranches
      remainder = len % numTranches
      sizes = replicate remainder (baseSize + 1) <> replicate (numTranches - remainder) baseSize
  in splitAtSizes holdings sizes

groupHoldingsByInvestor : [(Party, ContractId Holding.Holding)] -> [(Party, [ContractId Holding.Holding])]
groupHoldingsByInvestor holdings =
  let investors = dedupSort $ map fst holdings
      groupForInvestor inv = (inv, map snd $ filter (\(p, _) -> p == inv) holdings)
  in map groupForInvestor investors

calculateNumHoldingsNeeded : [(Party, ContractId Holding.Holding)] -> Decimal -> Int
calculateNumHoldingsNeeded holdings targetAmount =
  let totalHoldings = length holdings
      avgAmountPerHolding = if totalHoldings > 0 then targetAmount / intToDecimal totalHoldings else 0.0
  in ceiling (targetAmount / avgAmountPerHolding)

verifyAmulets : Party -> [ContractId Amulet.Amulet] -> Update Decimal
verifyAmulets dsoParty amulets = do
  let verifyAmulet amuletCid = do
        amulet <- fetch amuletCid
        assertMsg "Amulet DSO must match" (amulet.dso == dsoParty)
        pure amulet.amount.initialAmount
  amounts <- mapA verifyAmulet amulets
  pure $ sum amounts

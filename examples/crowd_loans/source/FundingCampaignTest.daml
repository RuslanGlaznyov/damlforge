testCreateInstallments : Script ()
testCreateInstallments = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid <- tap parties.app parties.investor1 120000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid]
    amount = 100000.0
    appTransferContext

  passTime (days 31)

  now <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2 FundingCampaign_Finalize with
    currentTime = now

  campaignsCheck <- query @FundingCampaign parties.platform
  let [(_, cCheck)] = campaignsCheck
  assert (cCheck.status == FC.Successful)

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (installmentCids, _) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext2

  assert (length installmentCids == 3)

  campaignsAfter <- query @FundingCampaign parties.platform
  let [(_, cAfter)] = campaignsAfter
  assert (cAfter.status == FC.Completed)

  pure ()

testInstallmentRelease : Script ()
testInstallmentRelease = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid <- tap parties.app parties.investor1 120000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid]
    amount = 100000.0
    appTransferContext

  passTime (days 31)

  now <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2 FundingCampaign_Finalize with
    currentTime = now

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (installmentCids, _) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext2

  let [installment1Cid, _, _] = installmentCids

  passTime (days 38)

  now2 <- getTime
  appTransferContext3 <- getAppTransferContext parties.app parties.platform
  let acceptDeadline = addRelTime now2 (days 7)
  (_, transferCid, platformHoldings) <- submit (actAs [parties.platform, parties.app.dso]) $ exerciseCmd installment1Cid FC.InstallmentRelease_Release with
    currentTime = now2
    acceptBefore = acceptDeadline

  developerHoldings <- submit (actAs [parties.developer, parties.app.dso]) $ exerciseCmd transferCid FC.InstallmentTransfer_Accept with
    currentTime = now2
    appTransferContext = appTransferContext3

  assert (length developerHoldings > 0 || length platformHoldings > 0)

  pure ()

testInstallmentTransferReject : Script ()
testInstallmentTransferReject = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid <- tap parties.app parties.investor1 120000.0

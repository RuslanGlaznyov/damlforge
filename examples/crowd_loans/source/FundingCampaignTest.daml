testClaimRefund : Script ()
testClaimRefund = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid <- tap parties.app parties.investor1 60000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid]
    amount = 50000.0
    appTransferContext

  passTime (days 31)

  now <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2 FundingCampaign_Finalize with
    currentTime = now

  campaignsCheck <- query @FundingCampaign parties.platform
  let [(_, cCheck)] = campaignsCheck
  assert (cCheck.status == FC.Failed)

  investorAmuletsBefore <- query @Amulet.Amulet parties.investor1
  let balanceBefore = sum [a.amount.initialAmount | (_, a) <- investorAmuletsBefore]

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (_, refundedHoldings) <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid3 FundingCampaign_ClaimRefund with
    investor = parties.investor1
    receiver = parties.investor1
    appTransferContext = appTransferContext2

  assert (length refundedHoldings == 1)

  investorAmuletsAfter <- query @Amulet.Amulet parties.investor1
  let balanceAfter = sum [a.amount.initialAmount | (_, a) <- investorAmuletsAfter]

  assert (balanceAfter > balanceBefore)

  pure ()

testCancelAfterFirstInstallmentRelease : Script ()
testCancelAfterFirstInstallmentRelease = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid1 <- tap parties.app parties.investor1 40000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid1]
    amount = 35000.0
    appTransferContext

  amuletCid2 <- tap parties.app parties.investor2 40000.0
  appTransferContext2a <- getAppTransferContext parties.app parties.platform

  campaignCid2b <- submit (actAs [parties.investor2, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2 FundingCampaign_Invest with
    investor = parties.investor2
    inputs = [amuletCid2]
    amount = 35000.0
    appTransferContext = appTransferContext2a

  amuletCid3 <- tap parties.app parties.investor3 40000.0
  appTransferContext2b <- getAppTransferContext parties.app parties.platform

  campaignCid2c <- submit (actAs [parties.investor3, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2b FundingCampaign_Invest with
    investor = parties.investor3
    inputs = [amuletCid3]
    amount = 35000.0
    appTransferContext = appTransferContext2b

  passTime (days 31)

  now <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2c FundingCampaign_Finalize with
    currentTime = now

  appTransferContext3 <- getAppTransferContext parties.app parties.platform
  (installmentCids, campaignCid4) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext3

  let [installment1Cid, _, _] = installmentCids

  passTime (days 38)

  now2 <- getTime
  let acceptDeadline = addRelTime now2 (days 7)
  _ <- submit (actAs [parties.platform, parties.app.dso]) $ exerciseCmd installment1Cid FC.InstallmentRelease_Release with
    currentTime = now2
    acceptBefore = acceptDeadline

  void $ submit (actAs [parties.platform, parties.developer]) $ exerciseCmd campaignCid4 FundingCampaign_Cancel

  campaignsAfter <- query @FundingCampaign parties.platform
  let [(_, cAfter)] = campaignsAfter
  assert (cAfter.status == FC.Cancelled)

  pure ()

testLoanRepaymentAutoDistribute : Script ()
testLoanRepaymentAutoDistribute = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  now3 <- getTime
  let milestone1 = LT.RepaymentMilestone with
        dueDate = addRelTime now3 (days 90)
        amount = 40000.0
        paid = False
        paidDate = None
  let milestone2 = LT.RepaymentMilestone with
        dueDate = addRelTime now3 (days 180)
        amount = 40000.0
        paid = False
        paidDate = None
  let milestone3 = LT.RepaymentMilestone with
        dueDate = addRelTime now3 (days 270)
        amount = 40000.0
        paid = False
        paidDate = None
  let repaymentSchedule = LT.RepaymentSchedule with
        milestones = [milestone1, milestone2, milestone3]
  let loanRewards = LT.LoanRewards with
        multiplier = 1.2
        repaymentSchedule
        numberOfPeriods = 4
        periodPayments = []
  let loanTermsData = LT.LoanTerms with
        loanRewards = Some loanRewards
        performanceRewards = None

  campaignCid <- createTestCampaignWithLoanTerms parties instrumentId termsAllOrNothing loanTermsData

  amuletCid <- tap parties.app parties.investor1 120000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid]
    amount = 100000.0
    appTransferContext

  passTime (days 31)

  now2 <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2 FundingCampaign_Finalize with
    currentTime = now2

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (_, _) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext2

  loanTrackers <- query @LoanTracker parties.platform
  assert (length loanTrackers == 1)
  let [(loanTrackerCid, loanTrackerData)] = loanTrackers
  assert (loanTrackerData.totalRaised == 100000.0)
  assert (length loanTrackerData.investments == 1)

  developerAmulet <- tap parties.app parties.developer 50000.0
  appTransferContext3 <- getAppTransferContext parties.app parties.platform

  loanTrackerCid2 <- submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid LoanTracker_Deposit with
    inputs = [developerAmulet]
    amount = 40000.0
    appTransferContext = appTransferContext3

  now4 <- getTime
  let claimDeadline = addRelTime now4 (days 30)

  void $ submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid2 LoanTracker_Repay with
    repayAmount = 40000.0
    currentTime = now4
    claimBefore = claimDeadline

  loanTrackers2 <- query @LoanTracker parties.platform
  let [(_, lt)] = loanTrackers2
  assert (lt.totalRepaid == 40000.0)
  assert (length lt.repaymentHistory == 1)

  let [distribution] = lt.repaymentHistory
  assert (distribution.investor == parties.investor1)
  assert (distribution.amount == 40000.0)

  claims <- query @RepaymentClaim parties.platform
  assert (length claims == 1)
  let [(claimCid, claim)] = claims
  assert (claim.investor == parties.investor1)
  assert (claim.status == LT.ClaimPending)

  appTransferContext4 <- getAppTransferContext parties.app parties.platform
  now5 <- getTime
  _ <- submit (actAs [parties.investor1, parties.app.dso]) $ exerciseCmd claimCid RepaymentClaim_Accept with
    currentTime = now5
    appTransferContext = appTransferContext4

  claimsAfter <- query @RepaymentClaim parties.platform
  assert (null claimsAfter)

  pure ()


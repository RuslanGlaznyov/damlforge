defaultTransferConfig : TransferConfig USD
defaultTransferConfig = TransferConfig with
  createFee = FixedFee 0.0
  holdingFee = RatePerRound 0.00002
  lockHolderFee = FixedFee 0.0
  transferFee = SteppedRate with
    initialRate = 0.0
    steps = []
  extraFeaturedAppRewardAmount = 1.0
  maxNumInputs = 100
  maxNumOutputs = 100
  maxNumLockHolders = 10

defaultBaseRateTrafficLimits : BaseRateTrafficLimits
defaultBaseRateTrafficLimits = BaseRateTrafficLimits with
  burstAmount = 10 * 20 * 1000
  burstWindow = minutes 10

defaultSynchronizerFeesConfig : SynchronizerFeesConfig
defaultSynchronizerFeesConfig = SynchronizerFeesConfig with
  baseRateTrafficLimits = defaultBaseRateTrafficLimits
  minTopupAmount = 1_000_000
  extraTrafficPrice = 1.0
  readVsWriteScalingFactor = 4

defaultAmuletDecentralizedSynchronizerConfig : AmuletDecentralizedSynchronizerConfig
defaultAmuletDecentralizedSynchronizerConfig = AmuletDecentralizedSynchronizerConfig with
  requiredSynchronizers = Set.fromList ["decentralized-synchronizer-id-0"]
  activeSynchronizer = "decentralized-synchronizer-id-0"
  fees = defaultSynchronizerFeesConfig

defaultIssuanceConfig : IssuanceConfig
defaultIssuanceConfig = IssuanceConfig with
  amuletToIssuePerYear = 40e9
  validatorRewardPercentage = 0.05
  appRewardPercentage = 0.15
  validatorRewardCap = 0.2
  featuredAppRewardCap = 100.0
  unfeaturedAppRewardCap = 0.6
  optValidatorFaucetCap = None
  optDevelopmentFundPercentage = None

defaultAmuletConfig : AmuletConfig USD
defaultAmuletConfig = AmuletConfig with
  transferConfig = defaultTransferConfig
  issuanceCurve = Schedule with
    initialValue = defaultIssuanceConfig
    futureValues = []
  decentralizedSynchronizer = defaultAmuletDecentralizedSynchronizerConfig
  tickDuration = minutes 10
  packageConfig = PackageConfig with
    amulet = "0.1.0"
    amuletNameService = "0.1.0"
    dsoGovernance = "0.1.0"
    validatorLifecycle = "0.1.0"
    wallet = "0.1.0"
    walletPayments = "0.1.0"
  transferPreapprovalFee = Some 0.000019
  featuredAppActivityMarkerAmount = Some 1.0
  optDevelopmentFundManager = None
  externalPartyConfigStateTickDuration = None
  rewardConfig = None

defaultAmuletConfigSchedule : Schedule Time (AmuletConfig USD)
defaultAmuletConfigSchedule = Schedule with
  initialValue = defaultAmuletConfig
  futureValues = []

data AmuletApp = AmuletApp with
    dso : Party
  deriving (Eq, Show)

data TestParties = TestParties
  with
    app : AmuletApp
    platform : Party
    developer : Party
    investor1 : Party
    investor2 : Party
    investor3 : Party

demoTime : Time
demoTime = time (DA.Date.date 2022 Jan 1) 0 0 0

setupApp : Script AmuletApp
setupApp = do
  setTime demoTime
  dso <- allocateParty "dso-party"

  _ <- submit dso $ createCmd AmuletRules with
    configSchedule = defaultAmuletConfigSchedule
    isDevNet = True
    contractStateSchemaVersion = None
    ..

  _ <- submit dso $ createCmd ExternalPartyAmuletRules with dso

  return AmuletApp with dso

bootstrapRounds : AmuletApp -> Script ()
bootstrapRounds app = do
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  void $ submit app.dso $ exerciseCmd amuletRulesCid AmuletRules_Bootstrap_Rounds with
    amuletPrice = 1.0
    round0Duration = hours 24
    initialRound = None

setupParties : Script TestParties
setupParties = do
  app <- setupApp
  bootstrapRounds app
  passTime (days 1)

  platform <- allocateParty "Platform"
  developer <- allocateParty "Developer"
  investor1 <- allocateParty "Investor1"
  investor2 <- allocateParty "Investor2"
  investor3 <- allocateParty "Investor3"

  setupValidator app platform
  setupValidator app developer
  setupValidator app investor1
  setupValidator app investor2
  setupValidator app investor3

  return TestParties with ..

setupValidator : AmuletApp -> Party -> Script ()
setupValidator app validatorParty = do
  sponsorParty <- allocateParty (partyToText validatorParty <> "_sponsor")
  now <- getTime
  void $ submit (actAs [validatorParty, app.dso]) $ createCmd ValidatorLicense with
    dso = app.dso
    sponsor = sponsorParty
    validator = validatorParty
    faucetState = None
    metadata = Some ValidatorLicenseMetadata with
      version = "0.1.0"
      contactPoint = partyToText validatorParty <> "@example.com"
      lastUpdatedAt = now
    lastActiveAt = Some now

  void $ submit (actAs [validatorParty, app.dso]) $
    createCmd ValidatorRight with dso = app.dso; validator = validatorParty; user = validatorParty

fetchAmuletRulesByKey : Party -> Script (ContractId AmuletRules, AmuletRules)
fetchAmuletRulesByKey dso = do
  amuletRules <- query @AmuletRules dso
  case amuletRules of
    [] -> abort "No active AmuletRules contract"
    [amuletRules] -> pure amuletRules
    rules -> abort $ "Expected 0 or 1 AmuletRules contracts but got " <> show (length rules)

getLatestActiveOpenRound : Party -> Script (ContractId OpenMiningRound, OpenMiningRound)
getLatestActiveOpenRound dso = do
  rounds <- query @OpenMiningRound dso
  case rounds of
    [] -> abort "No active open mining rounds"
    (first :: rest) -> pure $ foldl (\acc x -> if (snd x).round > (snd acc).round then x else acc) first rest

tap : AmuletApp -> Party -> Decimal -> Script (ContractId Amulet.Amulet)
tap app owner amount = do
  (openRoundCid, _) <- getLatestActiveOpenRound app.dso
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  result <- submit (actAs [owner] <> readAs [app.dso]) $ exerciseCmd amuletRulesCid AmuletRules_DevNet_Tap with
    receiver = owner
    amount
    openRound = openRoundCid
  return result.amuletSum.amulet

getAppTransferContext : AmuletApp -> Party -> Script AppTransferContext
getAppTransferContext app provider = do
  (openMiningRoundCid, _) <- getLatestActiveOpenRound app.dso
  (amuletRulesCid, _) <- fetchAmuletRulesByKey app.dso
  featuredAppRight <- getFeaturedAppRight app provider
  pure AppTransferContext with
    amuletRules = amuletRulesCid
    openMiningRound = openMiningRoundCid
    featuredAppRight

getFeaturedAppRight : AmuletApp -> Party -> Script (Optional (ContractId FeaturedAppRight))
getFeaturedAppRight app provider = do
  rights <- query @FeaturedAppRight provider
  case [cid | (cid, r) <- rights, r.dso == app.dso] of
    [] -> pure None
    (cid :: _) -> pure (Some cid)

termsAllOrNothing : FC.Terms
termsAllOrNothing = FC.Terms with
  platform_fees = 0.05
  fund_mode = FC.AllOrNothing
  cooldown_period_days = 7
  flexible_funding_minimum = 0.0
  cap_at_target = False
  locked_party = None
  unlocked_party = None

termsFlexible : FC.Terms
termsFlexible = FC.Terms with
  platform_fees = 0.05
  fund_mode = FC.Flexible
  cooldown_period_days = 7
  flexible_funding_minimum = 30000.0
  cap_at_target = False
  locked_party = None
  unlocked_party = None

createTestCampaign : TestParties -> Holding.InstrumentId -> FC.Terms -> Script (ContractId FundingCampaign)
createTestCampaign parties instrumentId terms = do
  now <- getTime
  submit (actAs [parties.platform, parties.developer]) $ createCmd FundingCampaign with
    platform = parties.platform
    developer = parties.developer
    dso = parties.app.dso
    externalId = "test-campaign-001"
    target = 100000.0
    deadline = addRelTime now (days 30)
    raised = 0.0
    balance = 0.0
    status = FC.Active
    acceptedInstrumentId = instrumentId
    terms = terms
    investments = None
    excessInvestments = None
    excessHoldings = None
    lockedHoldings = None
    unlockedHoldings = None
    refundedInvestors = None
    loanTerms = None
    finalizedAt = None

createTestCampaignWithLoanTerms : TestParties -> Holding.InstrumentId -> FC.Terms -> LT.LoanTerms -> Script (ContractId FundingCampaign)
createTestCampaignWithLoanTerms parties instrumentId terms loanTermsData = do
  now <- getTime
  submit (actAs [parties.platform, parties.developer]) $ createCmd FundingCampaign with
    platform = parties.platform
    developer = parties.developer
    dso = parties.app.dso
    externalId = "test-campaign-001"
    target = 100000.0
    deadline = addRelTime now (days 30)
    raised = 0.0
    balance = 0.0
    status = FC.Active
    acceptedInstrumentId = instrumentId
    terms = terms
    investments = None
    excessInvestments = None
    excessHoldings = None
    lockedHoldings = None
    unlockedHoldings = None
    refundedInvestors = None
    loanTerms = Some loanTermsData
    finalizedAt = None

testInvestSuccessAllOrNothing : Script ()
testInvestSuccessAllOrNothing = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amuletCid <- tap parties.app parties.investor1 210000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  _ <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amuletCid]
    amount = 100000.0
    appTransferContext

  campaigns <- query @FundingCampaign parties.platform
  let [(_, c)] = campaigns

  assert (c.raised == 100000.0)
  assert (length (fromOptional [] c.investments) == 1)
  assert (length (fromOptional [] c.lockedHoldings) == 1)
  assert (c.status == FC.Active)

  lockedAmulets <- query @LockedAmulet parties.app.dso
  assert (length lockedAmulets == 1)

  pure ()


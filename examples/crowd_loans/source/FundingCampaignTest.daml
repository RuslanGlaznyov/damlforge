testLoanPeriodPaymentBlocking : Script ()
testLoanPeriodPaymentBlocking = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  now3 <- getTime
  let milestone1 = LT.RepaymentMilestone with
        dueDate = addRelTime now3 (days 90)
        amount = 40000.0
        paid = False
        paidDate = None
  let repaymentSchedule = LT.RepaymentSchedule with
        milestones = [milestone1]
  let loanRewards = LT.LoanRewards with
        multiplier = 1.1
        repaymentSchedule
        numberOfPeriods = 3
        periodPayments = []
  let loanTermsData = LT.LoanTerms with
        loanRewards = Some loanRewards
        performanceRewards = None

  campaignCid <- createTestCampaignWithLoanTerms parties instrumentId termsAllOrNothing loanTermsData

  amulet1Cid <- tap parties.app parties.investor1 40000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amulet1Cid]
    amount = 35000.0
    appTransferContext

  amulet2Cid <- tap parties.app parties.investor1 40000.0
  appTransferContext2a <- getAppTransferContext parties.app parties.platform

  campaignCid2b <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2 FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amulet2Cid]
    amount = 35000.0
    appTransferContext = appTransferContext2a

  amulet3Cid <- tap parties.app parties.investor1 40000.0
  appTransferContext2b <- getAppTransferContext parties.app parties.platform

  campaignCid2c <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2b FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amulet3Cid]
    amount = 30000.0
    appTransferContext = appTransferContext2b

  passTime (days 31)

  now2 <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2c FundingCampaign_Finalize with
    currentTime = now2

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (installmentCids, _) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext2

  loanTrackers <- query @LoanTracker parties.platform
  assert (length loanTrackers == 1)
  let [(loanTrackerCid, loanTrackerData)] = loanTrackers
  assert (loanTrackerData.totalRaised == 100000.0)

  let [installment1Cid, installment2Cid, _] = installmentCids

  passTime (days 38)

  now4 <- getTime
  let acceptDeadline = addRelTime now4 (days 7)
  void $ submit (actAs [parties.platform, parties.app.dso]) $ exerciseCmd installment1Cid FC.InstallmentRelease_Release with
    currentTime = now4
    acceptBefore = acceptDeadline

  passTime (days 30)

  campaigns <- query @FundingCampaign parties.platform
  let [(campaignCid, _)] = campaigns

  (updatedInstallment2Cid, _) <- submit (actAs [parties.platform, parties.app.dso]) $ exerciseCmd installment2Cid FC.InstallmentRelease_Escrow with
    campaignCid = campaignCid

  now5 <- getTime
  let acceptDeadline2 = addRelTime now5 (days 7)

  submitMustFail (actAs [parties.platform, parties.app.dso]) $ exerciseCmd updatedInstallment2Cid FC.InstallmentRelease_Release with
    currentTime = now5
    acceptBefore = acceptDeadline2

  developerAmulet <- tap parties.app parties.developer 50000.0
  appTransferContext3 <- getAppTransferContext parties.app parties.platform

  loanTrackerCid2 <- submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid LoanTracker_Deposit with
    inputs = [developerAmulet]
    amount = 36667.0
    appTransferContext = appTransferContext3

  now6 <- getTime
  let claimDeadline = addRelTime now6 (days 30)

  (loanTrackerCid3, _) <- submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid2 LoanTracker_LoanRewardsRepay with
    repayAmount = 36667.0
    currentTime = now6
    claimBefore = claimDeadline

  paymentHistory <- submit parties.platform $ exerciseCmd loanTrackerCid3 LoanTracker_GetLoanRewardsHistory

  let paidPeriods = filter (\p -> p.status == LT.PeriodPaid) paymentHistory
  assert (length paidPeriods == 1)
  let [period1] = paidPeriods
  assert (period1.periodNumber == 1)
  assert (period1.amount > 0.0)

  pure ()


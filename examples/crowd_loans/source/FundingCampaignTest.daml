testInvestMultipleInvestors : Script ()
testInvestMultipleInvestors = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  campaignCid <- createTestCampaign parties instrumentId termsAllOrNothing

  amulet1Cid <- tap parties.app parties.investor1 60000.0
  appTransferContext1 <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amulet1Cid]
    amount = 50000.0
    appTransferContext = appTransferContext1

  amulet2Cid <- tap parties.app parties.investor2 85000.0
  appTransferContext2 <- getAppTransferContext parties.app parties.platform

  _ <- submit (actAs [parties.investor2, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2 FundingCampaign_Invest with
    investor = parties.investor2
    inputs = [amulet2Cid]
    amount = 75000.0
    appTransferContext = appTransferContext2

  campaigns <- query @FundingCampaign parties.platform
  let [(_, c)] = campaigns

  assert (c.raised == 125000.0)
  assert (length (fromOptional [] c.investments) == 2)
  assert (length (fromOptional [] c.lockedHoldings) == 2)

  pure ()


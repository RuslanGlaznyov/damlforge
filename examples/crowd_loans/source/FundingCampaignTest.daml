testLoanRewardsPrecisionHandling : Script ()
testLoanRewardsPrecisionHandling = script do
  parties <- setupParties

  let instrumentId = Holding.InstrumentId with
        admin = parties.app.dso
        id = "Amulet"

  let loanRewards = LT.LoanRewards with
        multiplier = 1.333333
        repaymentSchedule = LT.RepaymentSchedule with milestones = []
        numberOfPeriods = 7
        periodPayments = []
  let loanTermsData = LT.LoanTerms with
        loanRewards = Some loanRewards
        performanceRewards = None

  campaignCid <- createTestCampaignWithLoanTerms parties instrumentId termsAllOrNothing loanTermsData

  amulet1Cid <- tap parties.app parties.investor1 40000.0
  appTransferContext <- getAppTransferContext parties.app parties.platform

  campaignCid2 <- submit (actAs [parties.investor1, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid FundingCampaign_Invest with
    investor = parties.investor1
    inputs = [amulet1Cid]
    amount = 33333.33
    appTransferContext

  amulet2Cid <- tap parties.app parties.investor2 40000.0
  appTransferContext2a <- getAppTransferContext parties.app parties.platform

  campaignCid2b <- submit (actAs [parties.investor2, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2 FundingCampaign_Invest with
    investor = parties.investor2
    inputs = [amulet2Cid]
    amount = 33333.33
    appTransferContext = appTransferContext2a

  amulet3Cid <- tap parties.app parties.investor3 40000.0
  appTransferContext2b <- getAppTransferContext parties.app parties.platform

  campaignCid2c <- submit (actAs [parties.investor3, parties.app.dso] <> readAs [parties.platform]) $ exerciseCmd campaignCid2b FundingCampaign_Invest with
    investor = parties.investor3
    inputs = [amulet3Cid]
    amount = 33333.34
    appTransferContext = appTransferContext2b

  passTime (days 31)

  now2 <- getTime
  campaignCid3 <- submit parties.platform $ exerciseCmd campaignCid2c FundingCampaign_Finalize with
    currentTime = now2

  appTransferContext2 <- getAppTransferContext parties.app parties.platform
  (_, _) <- submit (actAs [parties.platform, parties.developer, parties.app.dso]) $ exerciseCmd campaignCid3 FundingCampaign_CreateInstallments with
    appTransferContext = appTransferContext2

  loanTrackers <- query @LoanTracker parties.platform
  assert (length loanTrackers == 1)
  let [(loanTrackerCid, loanTrackerData)] = loanTrackers
  assert (loanTrackerData.totalRaised == 100000.0)

  developerAmulet <- tap parties.app parties.developer 100000.0
  appTransferContext3 <- getAppTransferContext parties.app parties.platform

  loanTrackerCid2 <- submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid LoanTracker_Deposit with
    inputs = [developerAmulet]
    amount = 80000.0
    appTransferContext = appTransferContext3

  now4 <- getTime
  let claimDeadline = addRelTime now4 (days 30)

  let expectedPeriodAmount = 100000.0 * 1.333333 / 7.0

  (_, claimCids) <- submit (actAs [parties.platform, parties.app.dso] <> readAs [parties.developer]) $ exerciseCmd loanTrackerCid2 LoanTracker_LoanRewardsRepay with
    repayAmount = expectedPeriodAmount
    currentTime = now4
    claimBefore = claimDeadline

  assert (length claimCids == 3)

  loanTrackers2 <- query @LoanTracker parties.platform
  assert (length loanTrackers2 == 1)
  let [(_, loanTrackerData2)] = loanTrackers2
  assert (loanTrackerData2.totalRepaid > 0.0)

  pure ()
